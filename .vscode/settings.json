{
    "local-comment.storage.commentsConfig": "comments.json",
    "local-comment.storage.bookmarksConfig": "bookmarks.json",
    "ROS2.distro": "humble",
    "python.autoComplete.extraPaths": [
        "/opt/ros/humble/lib/python3.10/site-packages",
        "/opt/ros/humble/local/lib/python3.10/dist-packages"
    ],
    "python.analysis.extraPaths": [
        "/opt/ros/humble/lib/python3.10/site-packages",
        "/opt/ros/humble/local/lib/python3.10/dist-packages"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": [
        "--background-index",
        "--completion-style=detailed",
        "--header-insertion=never",
        "--query-driver=/usr/bin/c++,/home/sx/.espressif/tools/riscv32-esp-elf/*/riscv32-esp-elf/bin/riscv32-esp-elf-*"
    ],
    "cmake.buildDirectory": "${workspaceFolder}/build/host",
    "cmake.configureOnOpen": false,
    "cmake.configureSettings": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
    }
}
