{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clangd: 配置 ESP-IDF V2 构建",
            "type": "process",
            "command": "/bin/zsh",
            "args": [
                "-lc",
                "source /home/sx/develop/esp/esp-idf/export.sh && idf.py -B ${workspaceFolder}/build/esp-idf-v2 -D SDKCONFIG=${workspaceFolder}/build/esp-idf-v2/sdkconfig -D IDF_TARGET=esp32c3 -D PLANT_PRODUCT=v2 reconfigure"
            ],
            "problemMatcher": []
        },
        {
            "label": "clangd: 更新 ESP-IDF V2 编译数据库",
            "type": "process",
            "command": "cmake",
            "args": [
                "-E",
                "copy_if_different",
                "${workspaceFolder}/build/esp-idf-v2/compile_commands.json",
                "${workspaceFolder}/compile_commands.json"
            ],
            "dependsOrder": "sequence",
            "dependsOn": "clangd: 配置 ESP-IDF V2 构建",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "clangd: 配置 ESP-IDF V1 构建",
            "type": "process",
            "command": "/bin/zsh",
            "args": [
                "-lc",
                "source /home/sx/develop/esp/esp-idf/export.sh && idf.py -B ${workspaceFolder}/build/esp-idf-v1 -D SDKCONFIG=${workspaceFolder}/build/esp-idf-v1/sdkconfig -D IDF_TARGET=esp32c3 -D PLANT_PRODUCT=v1 reconfigure"
            ],
            "problemMatcher": []
        },
        {
            "label": "clangd: 更新 ESP-IDF V1 编译数据库",
            "type": "process",
            "command": "cmake",
            "args": [
                "-E",
                "copy_if_different",
                "${workspaceFolder}/build/esp-idf-v1/compile_commands.json",
                "${workspaceFolder}/compile_commands.json"
            ],
            "dependsOrder": "sequence",
            "dependsOn": "clangd: 配置 ESP-IDF V1 构建",
            "problemMatcher": []
        }
    ]
}
