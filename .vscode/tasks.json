{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clangd: 配置 ESP-IDF 构建",
            "type": "process",
            "command": "/bin/zsh",
            "args": [
                "-lc",
                "source /home/sx/develop/esp/esp-idf/export.sh && idf.py -B ${workspaceFolder}/build/esp-idf -D SDKCONFIG=${workspaceFolder}/build/esp-idf/sdkconfig -D IDF_TARGET=esp32c3 reconfigure"
            ],
            "problemMatcher": []
        },
        {
            "label": "clangd: 更新 ESP-IDF 编译数据库",
            "type": "process",
            "command": "cmake",
            "args": [
                "-E",
                "copy_if_different",
                "${workspaceFolder}/build/esp-idf/compile_commands.json",
                "${workspaceFolder}/compile_commands.json"
            ],
            "dependsOrder": "sequence",
            "dependsOn": "clangd: 配置 ESP-IDF 构建",
            "problemMatcher": []
        }
    ]
}
